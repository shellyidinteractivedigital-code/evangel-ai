{"name":"BillingAccount","type":"object","properties":{"user_id":{"type":"string","minLength":1},"stripe_customer_id":{"type":"string"},"stripe_subscription_id":{"type":"string"},"plan_key":{"type":"string","enum":["free","plus_monthly","plus_annual"],"default":"free"},"status":{"type":"string","enum":["free","incomplete","incomplete_expired","trialing","active","past_due","canceled","unpaid","paused","unknown"],"default":"free"},"current_period_end":{"type":"string","format":"date-time"},"cancel_at_period_end":{"type":"boolean","default":false},"last_verified_at":{"type":"string","format":"date-time"}},"required":["user_id","plan_key","status"],"rls":{"create":false,"read":{"data.user_id":"{{user.id}}"},"update":false,"delete":false}}