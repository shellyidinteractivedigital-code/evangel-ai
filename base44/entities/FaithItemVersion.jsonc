{
  "name": "FaithItemVersion",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "minLength": 1
    },
    "faith_item_id": {
      "type": "string",
      "minLength": 1
    },
    "version_number": {
      "type": "integer",
      "minimum": 1
    },
    "content": {
      "type": "object"
    },
    "settings": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "owner_user_id",
    "faith_item_id",
    "version_number",
    "content"
  ],
  "rls": {
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "read": {
      "data.owner_user_id": "{{user.id}}"
    },
    "update": {
      "data.owner_user_id": "{{user.id}}"
    },
    "delete": {
      "data.owner_user_id": "{{user.id}}"
    }
  }
}