{
  "name": "FaithRelation",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "minLength": 1
    },
    "from_item_id": {
      "type": "string",
      "minLength": 1
    },
    "to_item_id": {
      "type": "string",
      "minLength": 1
    },
    "relation_type": {
      "type": "string",
      "enum": [
        "supports",
        "references",
        "derived_from",
        "answers",
        "continues",
        "groups_with",
        "contrasts",
        "same_theme",
        "same_passage"
      ]
    },
    "label": {
      "type": "string",
      "maxLength": 160
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "owner_user_id",
    "from_item_id",
    "to_item_id",
    "relation_type"
  ],
  "rls": {
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "read": {
      "data.owner_user_id": "{{user.id}}"
    },
    "update": {
      "data.owner_user_id": "{{user.id}}"
    },
    "delete": {
      "data.owner_user_id": "{{user.id}}"
    }
  }
}