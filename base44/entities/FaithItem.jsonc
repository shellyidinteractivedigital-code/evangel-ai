{
  "name": "FaithItem",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "verse",
        "highlight",
        "note",
        "journal",
        "prayer",
        "answered_prayer",
        "study",
        "sermon",
        "word_study",
        "lesson",
        "collection",
        "voice_note"
      ]
    },
    "title": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "scripture_ref": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "group",
        "link"
      ],
      "default": "private"
    },
    "group_id": {
      "type": "string"
    },
    "source_item_id": {
      "type": "string"
    },
    "folder_id": {
      "type": "string"
    },
    "current_version_id": {
      "type": "string"
    },
    "generator_type": {
      "type": "string",
      "enum": [
        "prayer",
        "sermon",
        "scripture_study"
      ]
    },
    "generator_settings": {
      "type": "object"
    },
    "source_snapshot": {
      "type": "object"
    },
    "spatial": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "owner_user_id",
    "kind",
    "visibility"
  ],
  "rls": {
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "read": {
      "data.owner_user_id": "{{user.id}}"
    },
    "update": {
      "data.owner_user_id": "{{user.id}}"
    },
    "delete": {
      "data.owner_user_id": "{{user.id}}"
    }
  }
}